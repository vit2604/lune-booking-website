generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum RoomStatus {
  ACTIVE
  HIDDEN
  UNAVAILABLE
}

enum BookingStatus {
  RECEIVED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PAY_AT_PROPERTY
  FAILED
  REFUNDED
}

enum BookingSource {
  DIRECT_WEBSITE
}

enum ChatStatus {
  OPEN
  PENDING
  CLOSED
}

enum SenderType {
  GUEST
  ADMIN
  SYSTEM
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

enum MediaSource {
  URL
  UPLOAD
}

enum AiContentMode {
  REVIEW_REQUIRED
  AUTO_AFTER_UPLOAD
  FULL_AUTO_SAFE
}

enum AiWorkflowState {
  TREND_DETECTED
  IDEA_PROPOSED
  AWAITING_MEDIA
  MEDIA_UPLOADED
  MEDIA_ANALYZING
  MEDIA_REJECTED
  MEDIA_READY
  DRAFT_GENERATING
  DRAFT_READY
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISH_UNKNOWN
  PUBLISHED
  PUBLISH_FAILED
  PAUSED
  ARCHIVED
}

enum AiJobState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  DENIED
  NOT_REQUIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Room {
  id                      String            @id @default(cuid())
  slug                    String            @unique
  name                    String
  shortDescription        String
  fullDescription         String
  basePrice               Int
  weekendPrice            Int?
  holidayPrice            Int?
  longStayDiscountEnabled Boolean           @default(true)
  longStayMinNights       Int               @default(7)
  longStayDiscountPercent Float             @default(5)
  serviceFeePercent       Float             @default(0)
  taxPercent              Float             @default(0)
  minNights               Int               @default(1)
  maxNights               Int               @default(30)
  allowSameDayBooking     Boolean           @default(true)
  advanceBookingDays      Int               @default(365)
  cleaningBufferHours     Int               @default(0)
  size                    String
  maxGuests               Int
  bedType                 String
  numberOfBeds            Int               @default(1)
  status                  RoomStatus        @default(ACTIVE)
  isFeatured              Boolean           @default(false)
  sortOrder               Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  translations            RoomTranslation[]
  images                  RoomImage[]
  amenities               RoomAmenity[]
  blockedDates            RoomBlockedDate[]
  ratePeriods             RoomRatePeriod[]
  bookings                Booking[]
  bookingItems            BookingRoom[]
}

model RoomTranslation {
  id               String   @id @default(cuid())
  roomId           String
  languageCode     String
  name             String
  shortDescription String
  fullDescription  String
  priceNote        String?
  policiesJson     Json?
  suitableForJson  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, languageCode])
}

model RoomImage {
  id        String   @id @default(cuid())
  roomId    String
  url       String
  altText   String?
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Amenity {
  id        String        @id @default(cuid())
  key       String        @unique
  iconName  String?
  createdAt DateTime      @default(now())
  rooms     RoomAmenity[]
}

model RoomAmenity {
  roomId    String
  amenityId String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
}

model RoomBlockedDate {
  id        String   @id @default(cuid())
  roomId    String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RoomRatePeriod {
  id        String   @id @default(cuid())
  roomId    String
  startDate DateTime
  endDate   DateTime
  price     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
}

model Guest {
  id          String    @id @default(cuid())
  fullName    String
  email       String?
  phoneCode   String
  phoneNumber String
  country     String
  nationality String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]

  @@index([email])
  @@index([phoneNumber])
}

model Booking {
  id                 String        @id @default(cuid())
  bookingCode        String        @unique
  idempotencyKey     String?       @unique
  roomId             String
  guestId            String
  checkIn            DateTime
  checkOut           DateTime
  nights             Int
  guests             Int
  adults             Int           @default(1)
  children           Int           @default(0)
  pricePerNight      Int
  subtotal           Int
  discountAmount     Int           @default(0)
  serviceFee         Int           @default(0)
  taxAmount          Int           @default(0)
  totalPrice         Int
  currency           String        @default("VND")
  specialRequest     String?
  arrivalTime        String?
  bookingStatus      BookingStatus @default(RECEIVED)
  paymentStatus      PaymentStatus @default(PENDING)
  paymentMethod      String?
  internalNote       String?
  bluejayBookingId   String?
  bluejayBookingCode String?
  bluejaySyncStatus  String        @default("NOT_SYNCED")
  bluejaySyncError   String?
  bluejaySyncedAt    DateTime?
  confirmationEmailSentAt       DateTime?
  confirmationEmailClaimedAt    DateTime?
  confirmationEmailNextAttemptAt DateTime?
  confirmationEmailAttempts     Int           @default(0)
  confirmationEmailError        String?
  source             BookingSource @default(DIRECT_WEBSITE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  room               Room          @relation(fields: [roomId], references: [id])
  guest              Guest         @relation(fields: [guestId], references: [id])
  payments           Payment[]
  roomItems          BookingRoom[]
}

model BookingRoom {
  id             String   @id @default(cuid())
  bookingId      String
  roomId         String
  quantity       Int      @default(1)
  guests         Int      @default(1)
  adults         Int      @default(1)
  children       Int      @default(0)
  pricePerNight  Int
  subtotal       Int
  discountAmount Int      @default(0)
  serviceFee     Int      @default(0)
  taxAmount      Int      @default(0)
  totalPrice     Int
  currency       String   @default("VND")
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room           Room     @relation(fields: [roomId], references: [id])

  @@unique([bookingId, roomId])
  @@index([roomId])
}

model PhoneOtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  tokenHash  String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  lastSentAt DateTime  @default(now())
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([phone, createdAt])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  method          String
  provider        String?
  amount          Int
  currency        String        @default("VND")
  status          PaymentStatus @default(PENDING)
  transactionRef  String?
  transferContent String?
  rawPayloadJson  Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PaymentMethodSetting {
  id               String   @id @default(cuid())
  key              String   @unique
  displayName      String
  description      String?
  enabled          Boolean  @default(false)
  visibleForGuests Boolean  @default(true)
  sortOrder        Int      @default(0)
  configJson       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id            String        @id @default(cuid())
  sessionCode   String        @unique
  guestName     String?
  guestPhone    String?
  guestEmail    String?
  language      String        @default("en")
  bookingCode   String?
  status        ChatStatus    @default(OPEN)
  unreadByAdmin Int           @default(0)
  unreadByGuest Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
}

model ChatMessage {
  id             String      @id @default(cuid())
  sessionId      String
  senderType     SenderType
  senderName     String?
  message        String
  attachmentData String?
  attachmentMime String?
  attachmentName String?
  attachmentSize Int?
  readByAdmin    Boolean     @default(false)
  readByGuest    Boolean     @default(false)
  createdAt      DateTime    @default(now())
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CurrencyRateCache {
  id             String   @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  rate           Float
  provider       String
  lastUpdated    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency, provider])
}

model MediaAsset {
  id               String            @id @default(cuid())
  url              String
  type             MediaType         @default(IMAGE)
  altText          String?
  source           MediaSource       @default(URL)
  originalFilename String?
  safeFilename     String?
  detectedMime     String?
  sha256           String?           @unique
  perceptualHash   String?
  width            Int?
  height           Int?
  durationSeconds  Float?
  orientation      String?
  fileSizeBytes    BigInt?
  storageKey       String?
  capturedAt       DateTime?
  blurScore        Float?
  exposureScore    Float?
  audioScore       Float?
  faceCount        Int               @default(0)
  privacyFlags     Json?
  consentStatus    ConsentStatus     @default(UNKNOWN)
  qualityStatus    String            @default("PENDING")
  rejectionReason  String?
  tags             Json?
  usageCount       Int               @default(0)
  lastUsedAt       DateTime?
  archivedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contentAssets    AiContentAsset[]
  consents         AiConsentRecord[]

  @@index([qualityStatus, createdAt])
  @@index([deletedAt])
}

model AiBusinessProfile {
  id              String        @id @default("lune")
  brandName       String
  address         String
  hotline         String
  website         String
  verifiedFacts   Json
  allowedCtas     Json
  languages       Json
  toneOfVoice     String
  forbiddenClaims Json
  trendKeywords   Json          @default("[]")
  autonomyMode    AiContentMode @default(REVIEW_REQUIRED)
  emergencyStop   Boolean       @default(false)
  updatedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AiTrendSignal {
  id                  String          @id @default(cuid())
  source              String
  sourceUrl           String?
  title               String
  summary             String?
  publishedAt         DateTime?
  fetchedAt           DateTime        @default(now())
  geographicScope     String?
  keywords            Json
  reliability         Float
  commercialUseStatus String
  dedupHash           String          @unique
  expiresAt           DateTime?
  score               Float?
  scoreBreakdown      Json?
  riskFlags           Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  ideas               AiContentIdea[]

  @@index([score, expiresAt])
}

model AiContentIdea {
  id                   String           @id @default(cuid())
  trendId              String?
  title                String
  objective            String
  audience             String
  contentPillar        String
  outputType           String
  keyMessage           String
  rationale            String
  sourceUrl            String?
  estimatedMinutes     Int              @default(15)
  recommendedPublishAt DateTime?
  expiresAt            DateTime?
  priority             Int              @default(50)
  allowedMode          AiContentMode    @default(REVIEW_REQUIRED)
  claimsToVerify       Json
  status               AiWorkflowState  @default(IDEA_PROPOSED)
  feedback             String?
  selectedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  trend                AiTrendSignal?   @relation(fields: [trendId], references: [id], onDelete: SetNull)
  shotItems            AiShotItem[]
  drafts               AiContentDraft[]

  @@index([status, createdAt])
}

model AiShotItem {
  id              String        @id @default(cuid())
  ideaId          String
  sortOrder       Int
  mediaType       String
  orientation     String
  aspectRatio     String
  durationSeconds Int?
  instruction     String
  position        String?
  cameraDirection String?
  movement        String?
  lighting        String?
  preparation     String?
  avoid           String?
  acceptance      String
  fallback        String?
  takes           Int           @default(2)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  idea            AiContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, sortOrder])
}

model AiContentDraft {
  id                   String           @id @default(cuid())
  ideaId               String?
  state                AiWorkflowState  @default(DRAFT_READY)
  version              Int              @default(1)
  captionVi            String
  captionEn            String
  captionKo            String?
  shortCaption         String
  headline             String
  cta                  String
  hashtags             Json
  altText              String
  factsUsed            Json
  sourceIds            Json
  riskFlags            Json
  confidence           Float
  recommendedPublishAt DateTime?
  approvedAt           DateTime?
  approvedById         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  idea                 AiContentIdea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  assets               AiContentAsset[]
  publications         AiPublication[]

  @@index([state, recommendedPublishAt])
}

model AiContentAsset {
  id           String         @id @default(cuid())
  draftId      String
  mediaAssetId String
  role         String
  sortOrder    Int            @default(0)
  renderMeta   Json?
  createdAt    DateTime       @default(now())
  draft        AiContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([draftId, mediaAssetId, role])
}

model AiPublication {
  id                String                 @id @default(cuid())
  draftId           String
  idempotencyKey    String                 @unique
  publisher         String                 @default("mock")
  pageId            String?
  approvedVersion   Int
  contentHash       String
  state             AiWorkflowState        @default(SCHEDULED)
  scheduledAt       DateTime?
  claimedAt         DateTime?
  claimOwner        String?
  remotePostId      String?                @unique
  remotePermalink   String?
  failureCode       String?
  failureMessage    String?
  reconciliationDue Boolean                @default(false)
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  draft             AiContentDraft         @relation(fields: [draftId], references: [id], onDelete: Restrict)
  attempts          AiPublicationAttempt[]
  analytics         AiAnalyticsSnapshot[]

  @@unique([draftId, approvedVersion, publisher, pageId])
  @@index([state, scheduledAt])
}

model AiPublicationAttempt {
  id            String        @id @default(cuid())
  publicationId String
  attemptNumber Int
  status        String
  responseCode  Int?
  remotePostId  String?
  errorCategory String?
  errorMessage  String?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  publication   AiPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, attemptNumber])
}

model AiJob {
  id             String     @id @default(cuid())
  type           String
  payload        Json
  state          AiJobState @default(PENDING)
  idempotencyKey String     @unique
  scheduledAt    DateTime   @default(now())
  claimedAt      DateTime?
  claimOwner     String?
  claimToken     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  attempts       Int        @default(0)
  maxAttempts    Int        @default(5)
  lastError      String?
  finishedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([state, scheduledAt])
  @@index([claimOwner, heartbeatAt])
}

model AiMetaConnection {
  id                   String    @id @default(cuid())
  pageId               String    @unique
  pageName             String
  tokenCiphertext      String
  tokenIv              String
  tokenAuthTag         String
  encryptionKeyVersion String
  grantedScopes        Json
  tokenExpiresAt       DateTime?
  connectedById        String
  connectedAt          DateTime  @default(now())
  lastHealthCheckAt    DateTime?
  disconnectedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AiMetaOAuthState {
  id          String    @id @default(cuid())
  stateHash   String    @unique
  adminId     String
  redirectUri String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminId, expiresAt])
}

model AiAnalyticsSnapshot {
  id            String        @id @default(cuid())
  publicationId String
  windowHours   Int
  reach         Int           @default(0)
  impressions   Int           @default(0)
  reactions     Int           @default(0)
  comments      Int           @default(0)
  shares        Int           @default(0)
  linkClicks    Int           @default(0)
  videoViews    Int           @default(0)
  watchTimeMs   BigInt        @default(0)
  isMock        Boolean       @default(false)
  capturedAt    DateTime      @default(now())
  publication   AiPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, windowHours])
}

model AiConsentRecord {
  id           String        @id @default(cuid())
  mediaAssetId String
  status       ConsentStatus
  scope        String
  evidenceRef  String?
  grantedAt    DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  mediaAsset   MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId, status])
}

model AiServiceUsage {
  id         String    @id @default(cuid())
  service    String
  periodKey  String
  units      Int       @default(0)
  hardLimit  Int
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([service, periodKey])
}

model AiAuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  correlationId String?
  ipHash        String?
  details       Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
